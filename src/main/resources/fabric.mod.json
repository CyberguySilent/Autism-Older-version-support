{
  "schemaVersion": 1,
  "id": "autism-older-support",
  "version": "${version}",
  "name": "AUTISM Older Version Support",
  "description": "Compatibility addon that backports AUTISM Client from 26.2 to older Minecraft versions",
  "authors": [
    "n1kvz"
  ],
  "contact": {
    "sources": "https://github.com/bestluaucoder/Autism-Older-version-support"
  },
  "license": "GPL-3.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.autismoldersupport.AutismOlderSupport"
    ]
  },
  "mixins": [
    "autism-older-support.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21 <=1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "autism": "*"
  }
}
